{
  "tests": [
    {
      "name": "Register new user",
      "method": "POST",
      "path": "/?action=register",
      "body": {"name": "Тест Юзер", "username": "testuser_ci", "password": "password123"},
      "expectedStatus": 200,
      "expectedBody": {"user": {"username": "testuser_ci"}},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login existing user",
      "method": "POST",
      "path": "/?action=login",
      "body": {"username": "testuser_ci", "password": "password123"},
      "expectedStatus": 200,
      "expectedBody": {"user": {"username": "testuser_ci"}},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login wrong password",
      "method": "POST",
      "path": "/?action=login",
      "body": {"username": "testuser_ci", "password": "wrongpass"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Неверный логин или пароль"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get users list",
      "method": "GET",
      "path": "/?action=users",
      "expectedStatus": 200,
      "expectedBody": {"users": []},
      "bodyMatcher": "partial"
    }
  ]
}